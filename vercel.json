{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/funnel/tick",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/funnel/distribute",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/updates/scrape-rates",
      "schedule": "7 6 * * *"
    },
    {
      "path": "/api/updates/pull-news",
      "schedule": "23 */4 * * *"
    },
    {
      "path": "/api/updates/roundup-generate",
      "schedule": "0 9 * * 5"
    },
    {
      "path": "/api/cron/seo-resubmit",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/ctr-monitor",
      "schedule": "0 9 * * 1"
    }
  ]
}
